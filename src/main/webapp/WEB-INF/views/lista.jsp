<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>
<% List<Filme> filmes=(List<Filme>)request.getAttribute("filmes");String q=(String)request.getAttribute("q"),genero=(String)request.getAttribute("genero"),ordem=(String)request.getAttribute("ordem"); %>
<section class="hero"><div><p class="eyebrow">BIBLIOTECA WILL · SEU CATÁLOGO PESSOAL</p><h1>Seus filmes favoritos, em um só lugar.</h1><p>Encontre uma história para revisitar ou adicione uma nova à sua coleção.</p></div><a class="button" href="<%=base%>/filmes?acao=novo">Adicionar filme</a></section>
<section id="colecao" class="collection"><div class="section-heading"><h2>Minha coleção <span class="count"><%=request.getAttribute("total")%></span></h2><span class="collection-label">FILMES DO SEU ACERVO</span></div>
<nav class="catalog-tabs" aria-label="Organizar coleção"><a class="<%=ordem.isEmpty()?"active":""%>" href="<%=base%>/filmes?q=<%=java.net.URLEncoder.encode(q,java.nio.charset.StandardCharsets.UTF_8)%>&amp;genero=<%=java.net.URLEncoder.encode(genero,java.nio.charset.StandardCharsets.UTF_8)%>#colecao">Todos os filmes</a><a class="<%=ordem.equals("avaliacao")?"active":""%>" href="<%=base%>/filmes?ordem=avaliacao&amp;q=<%=java.net.URLEncoder.encode(q,java.nio.charset.StandardCharsets.UTF_8)%>&amp;genero=<%=java.net.URLEncoder.encode(genero,java.nio.charset.StandardCharsets.UTF_8)%>#colecao"><span aria-hidden="true">★</span> Melhores avaliações</a><a class="<%=ordem.equals("ano")?"active":""%>" href="<%=base%>/filmes?ordem=ano&amp;q=<%=java.net.URLEncoder.encode(q,java.nio.charset.StandardCharsets.UTF_8)%>&amp;genero=<%=java.net.URLEncoder.encode(genero,java.nio.charset.StandardCharsets.UTF_8)%>#colecao">Mais recentes</a></nav>
<form class="filters" method="get" action="<%=base%>/filmes" role="search"><div class="search-field"><span aria-hidden="true">⌕</span><label class="sr-only" for="q">Buscar por título ou diretor</label><input id="q" name="q" type="search" placeholder="Buscar por título ou diretor..." maxlength="150" value="<%=Html.e(q)%>"></div><div class="select-field"><label class="sr-only" for="genero">Gênero</label><select name="genero" id="genero"><option value="">Todos os gêneros</option><% for(String g:(List<String>)request.getAttribute("generos")){ %><option <%=g.equals(genero)?"selected":""%> value="<%=Html.e(g)%>"><%=Html.e(g)%></option><% } %></select></div><div class="select-field"><label class="sr-only" for="ordem">Ordenar filmes</label><select name="ordem" id="ordem"><option value="">Título: A–Z</option><option value="ano" <%=ordem.equals("ano")?"selected":""%>>Mais recentes</option><option value="avaliacao" <%=ordem.equals("avaliacao")?"selected":""%>>Melhor avaliação</option></select></div><button class="button secondary" type="submit">Buscar</button></form>
<div class="results-line"><span><%=filmes.size()%> <%=filmes.size()==1?"filme encontrado":"filmes encontrados"%><%if(!q.isEmpty()){%> para “<%=Html.e(q)%>”<%}%></span><%if(!q.isEmpty()||!genero.isEmpty()||!ordem.isEmpty()){%><a href="<%=base%>/filmes#colecao">Limpar filtros</a><%}else{%><span class="view-label">Clique em um pôster para ver os detalhes</span><%}%></div>
<% if(filmes.isEmpty()){ %><div class="empty"><span aria-hidden="true">◉</span><h3>Nenhum filme por aqui.</h3><p><%=q.isEmpty()&&genero.isEmpty()?"Sua próxima história começa com o primeiro filme.":"Tente outro título, diretor ou gênero."%></p><a class="button" href="<%=base%>/filmes?acao=novo">Adicionar filme</a></div><% } else { %><div class="film-grid"><%for(Filme f:filmes){%><article class="film-card"><a class="poster <%=f.getCapa()!=null?"has-cover":"poster-default"%>" href="<%=base%>/filmes?acao=detalhes&amp;id=<%=f.getId()%>" aria-label="Ver detalhes de <%=Html.e(f.getTitulo())%>"><% if(f.getCapa()!=null){ %><img class="movie-cover" src="<%=base%>/assets/posters/<%=Html.e(f.getCapa())%>" alt="Pôster de <%=Html.e(f.getTitulo())%>" loading="lazy" decoding="async" width="320" height="480"><% }else{ %><span class="poster-edition">BIBLIOTECA WILL / COLEÇÃO</span><div class="poster-shape" aria-hidden="true"></div><span class="poster-year"><%=f.getAno()%></span><span class="poster-title"><%=Html.e(f.getTitulo())%></span><span class="poster-director">UM FILME DE<br><%=Html.e(f.getDiretor())%></span><% } %><span class="poster-open" aria-hidden="true">↗</span></a><div class="card-info"><h3><a href="<%=base%>/filmes?acao=detalhes&amp;id=<%=f.getId()%>"><%=Html.e(f.getTitulo())%></a></h3><div class="card-meta"><span><%=f.getAno()%> <span class="film-type">Filme</span></span><span class="rating"><span aria-hidden="true">★</span> <%=f.getAvaliacao()==0?"—":f.getAvaliacao()+"/5"%></span></div><p class="card-genre"><%=Html.e(f.getGenero())%></p></div></article><%}%></div><%}%></section>
<section id="generos" class="genre-section"><h2>Explorar por gênero</h2><p>Escolha um gênero para filtrar os filmes da sua coleção.</p><div class="genre-links"><%for(String g:(List<String>)request.getAttribute("generos")){%><a class="<%=g.equals(genero)?"selected":""%>" href="<%=base%>/filmes?genero=<%=java.net.URLEncoder.encode(g,java.nio.charset.StandardCharsets.UTF_8)%>#colecao"><%=Html.e(g)%></a><%}%></div></section><div class="collection-end"><div><h2>Tem mais algum filme na sua lista?</h2><p>Adicione título, diretor e uma sinopse para consultar depois.</p></div><a class="button" href="<%=base%>/filmes?acao=novo">＋ Adicionar filme</a></div>
<%@ include file="footer.jspf" %>
