<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>
<%Filme f=(Filme)request.getAttribute("filme");%>
<nav class="breadcrumbs" aria-label="Caminho da página"><a href="<%=base%>/filmes">Início</a><span>›</span><a href="<%=base%>/filmes?genero=<%=java.net.URLEncoder.encode(f.getGenero(),java.nio.charset.StandardCharsets.UTF_8)%>#colecao"><%=Html.e(f.getGenero())%></a><span>›</span><span><%=Html.e(f.getTitulo())%></span></nav>
<section class="detail"><aside class="detail-sidebar"><div class="poster detail-poster <%=f.getCapa()!=null?"has-cover":"poster-default"%>"><%if(f.getCapa()!=null){%><img class="movie-cover" src="<%=base%>/assets/posters/<%=Html.e(f.getCapa())%>" alt="Pôster de <%=Html.e(f.getTitulo())%>" width="320" height="480"><%}else{%><span class="poster-edition">BIBLIOTECA WILL</span><span class="poster-title"><%=Html.e(f.getTitulo())%></span><span class="poster-director"><%=Html.e(f.getDiretor())%></span><%}%></div><p class="poster-caption">Em sua coleção</p><a class="button" href="<%=base%>/filmes?acao=editar&amp;id=<%=f.getId()%>">Editar filme ↗</a><a class="button danger-outline" href="<%=base%>/filmes?acao=excluir&amp;id=<%=f.getId()%>">Excluir filme</a></aside>
<div class="detail-copy"><div class="detail-title"><h1><%=Html.e(f.getTitulo())%></h1><span><%=f.getAno()%></span></div><p class="detail-kicker">BIBLIOTECA WILL / FICHA DO FILME</p><div class="detail-meta"><span class="detail-score"><span aria-hidden="true">★</span> <%=f.getAvaliacao()==0?"Sem nota":f.getAvaliacao()+"/5"%></span><span class="meta-separator">|</span><span><%=f.getAno()%></span><span class="meta-separator">|</span><span class="film-type">Filme</span><span class="meta-separator">|</span><a href="<%=base%>/filmes?genero=<%=java.net.URLEncoder.encode(f.getGenero(),java.nio.charset.StandardCharsets.UTF_8)%>#colecao"><%=Html.e(f.getGenero())%></a></div>
<div class="detail-information"><div class="synopsis-block"><h2>Sinopse</h2><p class="synopsis"><%=Html.e(f.getSinopse())%></p><section class="detail-rating"><h2>Minha avaliação</h2><span aria-label="<%=f.getAvaliacao()%> de 5 estrelas"><%="★".repeat(f.getAvaliacao())+"☆".repeat(5-f.getAvaliacao())%></span><p><%=f.getAvaliacao()==0?"Você ainda não avaliou este filme.":"Sua avaliação · "+f.getAvaliacao()+" de 5 estrelas"%></p><a class="text-link" href="<%=base%>/filmes?acao=editar&amp;id=<%=f.getId()%>">Alterar avaliação →</a></section></div><dl class="movie-facts"><dt>Diretor</dt><dd><%=Html.e(f.getDiretor())%></dd><dt>Ano de lançamento</dt><dd><%=f.getAno()%></dd><dt>Gênero</dt><dd><%=Html.e(f.getGenero())%></dd><dt>Tipo</dt><dd>Filme</dd></dl></div>
<div class="detail-collection"><div><h2>Seu catálogo, do seu jeito.</h2><p>Mantenha a ficha atualizada e encontre seus filmes favoritos quando quiser.</p></div><a class="button secondary" href="<%=base%>/filmes">Voltar ao catálogo</a></div></div></section>
<%@ include file="footer.jspf" %>
