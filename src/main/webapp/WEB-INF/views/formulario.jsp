<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>
<%Filme f=(Filme)request.getAttribute("filme");boolean novo=f.getId()==null;%>
<a class="back" href="<%=base%>/filmes">← Voltar ao catálogo</a><div class="page-intro"><p class="eyebrow">FICHA DO ACERVO</p><h1><%=novo?"Adicionar filme":"Editar filme"%><span class="brand-dot">.</span></h1><p>Registre as informações do filme para consultar depois.</p></div>
<%if(request.getAttribute("erros")!=null){%><div class="notice error" role="alert"><strong>Revise os campos abaixo:</strong><ul><%for(String error:(List<String>)request.getAttribute("erros")){%><li><%=Html.e(error)%></li><%}%></ul></div><%}%>
<form class="film-form panel" method="post" action="<%=base%>/filmes"><input type="hidden" name="acao" value="salvar"><input type="hidden" name="csrf" value="<%=Html.e(session.getAttribute("csrf"))%>"><%if(!novo){%><input type="hidden" name="id" value="<%=f.getId()%>"><%}%><div class="form-section"><span class="step">01</span><div><h2>Informações do filme</h2><p>Todos os campos são obrigatórios, exceto a avaliação.</p></div></div><div class="form-grid"><div class="field"><label for="titulo">Título <span>*</span></label><input id="titulo" name="titulo" required maxlength="150" placeholder="Ex.: Interestelar" value="<%=Html.e(f.getTitulo())%>"></div><div class="field"><label for="diretor">Diretor(a) <span>*</span></label><input id="diretor" name="diretor" required maxlength="120" placeholder="Ex.: Christopher Nolan" value="<%=Html.e(f.getDiretor())%>"></div><div class="field"><label for="ano">Ano de lançamento <span>*</span></label><input id="ano" name="ano" type="number" required min="1888" max="<%=Year.now().getValue()+5%>" value="<%=Html.e(f.getAno())%>"></div><div class="field"><label for="filme-genero">Gênero <span>*</span></label><select id="filme-genero" name="genero" required><option value="">Selecione um gênero</option><%for(String g:(List<String>)request.getAttribute("generos")){%><option <%=g.equals(f.getGenero())?"selected":""%> value="<%=Html.e(g)%>"><%=Html.e(g)%></option><%}%></select></div><div class="field full"><label for="sinopse">Sinopse <span>*</span></label><textarea id="sinopse" name="sinopse" rows="5" required maxlength="2000" aria-describedby="sinopse-ajuda" placeholder="Sem muitos spoilers: sobre o que é o filme?"><%=Html.e(f.getSinopse())%></textarea><span class="field-hint" id="sinopse-ajuda">Uma breve descrição. Até 2.000 caracteres.</span></div><div class="field full"><label for="avaliacao">Sua avaliação</label><select name="avaliacao" id="avaliacao"><option value="0">Ainda não avaliei</option><%for(int i=1;i<=5;i++){%><option value="<%=i%>" <%=f.getAvaliacao()==i?"selected":""%>><%="★".repeat(i)%> — <%=i%> <%=i==1?"estrela":"estrelas"%></option><%}%></select></div></div><div class="form-actions"><a class="button secondary" href="<%=base%>/filmes">Cancelar</a><button class="button" type="submit"><%=novo?"Adicionar ao catálogo":"Salvar alterações"%> <span aria-hidden="true">↗</span></button></div></form>
<%@ include file="footer.jspf" %>
