<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="br.edu.cinearquivo.web.Html,br.edu.cinearquivo.model.Filme,java.util.*,java.time.Year" %>
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Biblioteca Will: seu catálogo pessoal de filmes. Organize, descubra e revisite suas histórias favoritas."><title><%=Html.e(request.getAttribute("tituloPagina")==null?"Biblioteca Will | Sua coleção de histórias":request.getAttribute("tituloPagina"))%></title><link rel="icon" href="<%=request.getContextPath()%>/assets/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"><script defer src="<%=request.getContextPath()%>/assets/app.js"></script></head><body>
<% String base=request.getContextPath(); %>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<header class="header"><a class="brand" href="<%=base%>/filmes" aria-label="Biblioteca Will, início"><span class="brand-icon" aria-hidden="true"><svg viewBox="0 0 36 36" width="32" height="32"><path d="M5 14h27v17H5z" fill="currentColor"/><path d="m5 11 25-7 2 8-27 7z" fill="#ff763f"/><path d="m10 10 5 6m5-9 5 6" stroke="#101010" stroke-width="3"/><path d="m16 19 8 4-8 4z" fill="#fff"/></svg></span><span>Biblioteca<b>Will</b></span></a><nav aria-label="Navegação principal"><a href="<%=base%>/filmes">Início</a><a href="<%=base%>/filmes#colecao">Filmes</a><a href="<%=base%>/filmes#generos">Gêneros</a><a href="<%=base%>/filmes?acao=sobre">O projeto</a></nav><a class="button small" href="<%=base%>/filmes?acao=novo">＋ Adicionar filme</a><a class="search-shortcut" href="<%=base%>/filmes#colecao" aria-label="Buscar filmes"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg></a></header>
<main id="conteudo" class="container">
<% if(request.getAttribute("sucesso")!=null){ %><div class="notice success" role="status"><%=Html.e(request.getAttribute("sucesso"))%></div><% } %>
