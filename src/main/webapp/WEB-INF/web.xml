<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
 <display-name>Biblioteca Will</display-name>
 <listener><listener-class>br.edu.cinearquivo.config.AppListener</listener-class></listener>
 <filter><filter-name>security</filter-name><filter-class>br.edu.cinearquivo.web.SecurityFilter</filter-class></filter>
 <filter-mapping><filter-name>security</filter-name><url-pattern>/*</url-pattern></filter-mapping>
 <servlet><servlet-name>filmes</servlet-name><servlet-class>br.edu.cinearquivo.web.FilmeServlet</servlet-class><load-on-startup>1</load-on-startup></servlet>
 <servlet-mapping><servlet-name>filmes</servlet-name><url-pattern>/filmes</url-pattern></servlet-mapping>
 <welcome-file-list><welcome-file>filmes</welcome-file></welcome-file-list>
 <session-config><session-timeout>30</session-timeout><cookie-config><http-only>true</http-only></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
 <error-page><error-code>404</error-code><location>/WEB-INF/views/nao-encontrado.jsp</location></error-page>
</web-app>
